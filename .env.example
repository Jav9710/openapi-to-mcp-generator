# ============================================================
# OpenAPI to MCP Generator - Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment

# ==================== Database ====================
DATABASE_TYPE=sqlite
# DATABASE_URL=postgresql://user:pass@localhost:5432/openapi_mcp
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=openapi_mcp
# DB_USER=postgres
# DB_PASSWORD=your-password

# ==================== Flask ====================
SECRET_KEY=change-this-to-a-random-string
FLASK_ENV=development
# FLASK_DEBUG=false

# ==================== Encryption ====================
# ENCRYPTION_KEY=your-32-byte-fernet-key

# ==================== Feature Toggles ====================
ENABLE_AI=false
ENABLE_STORAGE=false
ENABLE_OAUTH2=false
ENABLE_AGENTS=false

# ==================== Ollama (AI) ====================
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_TIMEOUT=120
OLLAMA_MODEL_SPEC_ANALYSIS=llama3.2:3b
OLLAMA_MODEL_CODE_GENERATION=codellama:7b
OLLAMA_MODEL_DOCUMENTATION=llama3.2:3b
OLLAMA_MODEL_VALIDATION=llama3.2:1b
OLLAMA_RATE_LIMIT_RPM=30
OLLAMA_CONCURRENT_REQUESTS=3

# ==================== MinIO (Storage) ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
# MINIO_REGION=us-east-1
# MINIO_BUCKET_SPECS=openapi-specs
# MINIO_BUCKET_ARTIFACTS=mcp-artifacts
# MINIO_BUCKET_REPORTS=reports
# MINIO_BUCKET_BACKUPS=backups

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0
# REDIS_CACHE_TTL=3600

# ==================== OAuth2 ====================
# OAUTH2_ISSUER=https://your-domain.auth0.com
# OAUTH2_CLIENT_ID=your-client-id
# OAUTH2_CLIENT_SECRET=your-client-secret
# OAUTH2_REDIRECT_URI=http://localhost:5000/api/auth/callback
# OAUTH2_SCOPES=openid profile email
# OAUTH2_TOKEN_STORE=memory
# OAUTH2_REFRESH_BUFFER=300

# ==================== Celery (Workers) ====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
